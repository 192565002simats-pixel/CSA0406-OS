#include <stdio.h>
#include <stdlib.h>

int main()
{
    int a[10], n, h, i, total = 0;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter requests: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter head position: ");
    scanf("%d", &h);

    for(i = 0; i < n; i++)
    {
        total += abs(h - a[i]);
        h = a[i];
    }

    total += abs(h - 199);
    total += 199;

    printf("Total head movement = %d", total);

    return 0;
}
