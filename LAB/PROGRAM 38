#include <stdio.h>
#include <stdlib.h>

int main()
{
    int a[10], n, head, i, total = 0;

    printf("Enter number of requests: ");
    scanf("%d", &n);

    printf("Enter requests: ");
    for(i = 0; i < n; i++)
        scanf("%d", &a[i]);

    printf("Enter head position: ");
    scanf("%d", &head);

    printf("Enter disk end: ");
    scanf("%d", &a[n]);

    for(i = 0; i < n; i++)
        total += abs(head - a[i]), head = a[i];

    total += abs(head - a[n]);

    printf("Total head movement = %d", total);

    return 0;
}

