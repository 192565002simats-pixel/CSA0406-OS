#include <stdio.h>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>
#include <dirent.h>
int main()
{
    int fd;
    struct stat s;
    DIR *d;
    struct dirent *file;
    fd = open("test.txt", O_CREAT | O_RDWR, 0644);
    printf("File descriptor: %d\n", fcntl(fd, F_GETFD));
    lseek(fd, 0, SEEK_END);
    printf("File pointer moved using lseek()\n");
    stat("test.txt", &s);
    printf("File size: %ld bytes\n", s.st_size);
    d = opendir(".");
    printf("Directory contents:\n");
    while ((file = readdir(d)) != NULL)
        printf("%s\n", file->d_name);
    closedir(d);
    close(fd);
    return 0;
}
