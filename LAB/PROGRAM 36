#include <stdio.h>

int main()
{
    int n, i, block[20];
    printf("Enter number of blocks: ");
    scanf("%d", &n);
    printf("Enter block numbers: ");
    for(i = 0; i < n; i++)
        scanf("%d", &block[i]);
    printf("Linked Allocation:\n");
    for(i = 0; i < n; i++)
    {
        if(i == n - 1)
            printf("%d -> NULL\n", block[i]);
        else
            printf("%d -> ", block[i]);
    }
    return 0;
}
