#include <stdio.h>
#include <string.h>
int main()
{
    FILE *fp;
    char line[100];

    fp = fopen("test.txt", "r");

    if (fp == NULL)
    {
        printf("File not found");
        return 0;
    }

    while (fgets(line, 100, fp))
    {
        if (strstr(line, "UNIX"))
            printf("%s", line);
    }

    fclose(fp);
    return 0;
}
