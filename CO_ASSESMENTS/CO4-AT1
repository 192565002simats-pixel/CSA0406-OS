    {
        printf("Allocation not possible\n");
        return 0;
    }
    if (ch == 1)
    {
        printf("Contiguous blocks: ");
        for (i = 0; i < f; i++)
            printf("%d ", i);
    }
    else if (ch == 2)
    {
        printf("Linked blocks: ");
        for (i = 0; i < f; i++)
            printf("%d ", i);
    }
    else if (ch == 3)
    {
        if (f + 1 > n)
            printf("Allocation not possible\n");
        else
        {
            printf("Index block: 0\n");
            printf("Indexed blocks: ");
            for (i = 1; i <= f; i++)
                printf("%d ", i);
        }
    }
    else
        printf("Invalid choice\n");
    return 0;
}
