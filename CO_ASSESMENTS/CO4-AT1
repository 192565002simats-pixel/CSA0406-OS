#include <stdio.h>
#include <stdlib.h>
int main()
{
    int a[10], n, h, size, i, j, t;
    int cscan, look, cur;
    printf("Enter number of requests: ");
    scanf("%d",&n);
    printf("Enter requests: ");
    for(i=0;i<n;i++)
        scanf("%d",&a[i]);
    printf("Enter head position: ");
    scanf("%d",&h);
    printf("Enter disk size: ");
    scanf("%d",&size);
    for(i=0;i<n;i++)
        for(j=i+1;j<n;j++)
            if(a[i]>a[j])
            {
                t=a[i];
                a[i]=a[j];
                a[j]=t;
            }
    cur=h;
    look=0;
    printf("\nLOOK: %d",h);
    for(i=0;i<n;i++)
        if(a[i]>=h)
        {
            look += abs(cur-a[i]);
            cur=a[i];
            printf(" -> %d",cur);
        }
    for(i=n-1;i>=0;i--)
        if(a[i]<h)
        {
            look += abs(cur-a[i]);
            cur=a[i];
            printf(" -> %d",cur);
        }
    printf("\nLOOK Movement = %d",look);
    cur=h;
    cscan=0;
    printf("\n\nC-SCAN: %d",h);
    for(i=0;i<n;i++)
        if(a[i]>=h)
        {
            cscan += abs(cur-a[i]);
            cur=a[i];
            printf(" -> %d",cur);
        }
    cscan += abs(cur-(size-1));
    cur=size-1;
    printf(" -> %d",cur);
    cscan += size-1;
    cur=0;
    printf(" -> 0");
    for(i=0;i<n;i++)
        if(a[i]<h)
        {
            cscan += abs(cur-a[i]);
            cur=a[i];
            printf(" -> %d",cur);
        }
    printf("\nC-SCAN Movement = %d",cscan);
    if(look<cscan)
        printf("\n\nLOOK is better.");
    else
        printf("\n\nC-SCAN is better.");
    return 0;
}
