#include <stdlib.h>
int main()
{
    int n,f,h,a[20],i,j;
    int type,sch,total=0;
    printf("Disk size: ");
    scanf("%d",&n);
    printf("File size: ");
    scanf("%d",&f);
    printf("Head: ");
    scanf("%d",&h);
    printf("1. Contiguous  2. Indexed: ");
    scanf("%d",&type);
    if(type==1)
    {
        printf("Blocks: ");
        for(i=0;i<f;i++)
        {
            a[i]=i;
            printf("%d ",a[i]);
        }
    }
    else
    {
        printf("Index block: 0\nBlocks: ");
        for(i=0;i<f;i++)
        {
            a[i]=i+1;
            printf("%d ",a[i]);
        }
    }
    printf("\n1. FCFS  2. SSTF: ");
    scanf("%d",&sch);
    printf("Seek: %d",h);
    if(sch==1)
    {
        for(i=0;i<f;i++)
        {
            total+=abs(h-a[i]);
            h=a[i];
            printf(" -> %d",h);
        }
    }
    else
    {
        for(i=0;i<f;i++)
        {
            j=0;
            for(int k=1;k<f;k++)
                if(abs(h-a[k])<abs(h-a[j]))
                    j=k;

            total+=abs(h-a[j]);
            h=a[j];
            printf(" -> %d",h);
        }
    }
    printf("\nTotal Seek Time = %d",total);
    return 0;
}
