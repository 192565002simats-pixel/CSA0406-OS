    printf("Enter bitmap (0=Free, 1=Allocated):\n");
    for(i = 0; i < n; i++)
        scanf("%d", &b[i]);
    printf("Enter blocks required: ");
    scanf("%d", &req);
    for(i = 0; i < n && count < req; i++)
    {
        if(b[i] == 0)
        {
            b[i] = 1;
            count++;
        }
    }
    if(count < req)
        printf("Not enough free space\n");
    else
        printf("Allocation successful\n");
    printf("Bitmap: ");
    for(i = 0; i < n; i++)
        printf("%d ", b[i]);
    printf("\nEnter block to deallocate: ");
    scanf("%d", &d);

    if(d >= 0 && d < n)
        b[d] = 0;
    printf("Bitmap after deallocation: ");
    for(i = 0; i < n; i++)
        printf("%d ", b[i]);
    return 0;
}
